{
  "name": "@moderno-ui/docs",
  "version": "0.0.2",
  "description": "Moderno docs — flat Astro + MDX + Content Collections, bilingual en/es, Svelte islands for live previews, autogenerated PropsTable, Theme Builder, and the static registry served under /r/.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prebuild": "node --experimental-strip-types ../../tooling/props-doc/src/bin.ts && node --experimental-strip-types ./scripts/copy-registry.ts && node --experimental-strip-types ./scripts/build-tailwind.ts",
    "dev": "pnpm run prebuild && astro dev",
    "build": "pnpm run prebuild && astro build && pnpm run index",
    "index": "pagefind --site dist/en --output-path dist/en/pagefind && pagefind --site dist/es --output-path dist/es/pagefind",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "check:parity": "node --experimental-strip-types ./scripts/check-parity.ts"
  },
  "dependencies": {
    "@fontsource/hedvig-letters-sans": "^5.3.0",
    "@fontsource/hedvig-letters-serif": "^5.3.0",
    "@lucide/astro": "^1.25.0",
    "@moderno-ui/charts-core": "workspace:*",
    "@moderno-ui/cli": "workspace:*",
    "@moderno-ui/core": "workspace:*",
    "@moderno-ui/css": "workspace:*",
    "@moderno-ui/svelte": "workspace:*",
    "@moderno-ui/theme-compile": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.10",
    "@moderno-ui/props-doc": "workspace:*",
    "@moderno-ui/react": "workspace:*",
    "@moderno-ui/solid": "workspace:*",
    "@moderno-ui/vue": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.3.1",
    "pagefind": "^1.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "solid-js": "^1.9.13",
    "svelte": "^5.43.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vue": "^3.5.38"
  }
}
