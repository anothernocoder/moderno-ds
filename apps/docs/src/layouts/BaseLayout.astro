---
import { getCollection } from "astro:content";
import { sidebarSections } from "../i18n/nav.ts";
import { defaultLocale, locales, splitId, useTranslations, type Locale } from "../i18n/ui.ts";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Search from "../components/Search.astro";
import TableOfContents from "../components/TableOfContents.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/docs.css";
import "@moderno-ui/css";
// Docs-site chrome only — the design system's own --font-sans/--font-mono
// contract stays untouched so live component previews keep showing the real,
// intentionally-neutral defaults. See docs.css for the --docs-font-* vars.
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Slug of the current page, used to build hreflang/canonical links. */
  slug: string;
  /** From `render(entry)` — when present, renders a right-rail TOC. */
  headings?: { depth: number; slug: string; text: string }[];
}

const { locale, title, description, slug, headings = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const t = useTranslations(locale);
const site = Astro.site ?? new URL("https://moderno.style");

// Sidebar: this locale's pages, grouped and ordered.
const sections = sidebarSections(
  (await getCollection("docs"))
    .map((entry) => ({ entry, ...splitId(entry.id) }))
    .filter((p) => p.locale === locale && p.slug !== "index")
    .map((p) => ({
      slug: p.slug,
      title: p.entry.data.title,
      group: p.entry.data.group,
      order: p.entry.data.order,
    })),
);

// BASE_URL has no trailing slash ("" on Vercel, "/moderno-ds" on GitHub
// Pages); normalize to always end in exactly one "/".
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const canonical = new URL(`${base}${locale}/${slug === "index" ? "" : slug}`, site);
const pageTitle = slug === "index" ? title : `${title} — Moderno`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(`${base}${l}/${slug === "index" ? "" : slug}`, site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(`${base}${defaultLocale}/${slug === "index" ? "" : slug}`, site).href}
    />
    <script is:inline>
      // Apply the persisted color scheme before paint to avoid a flash.
      const stored = localStorage.getItem("moderno-scheme");
      if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t("nav.skipToContent")}</a>
    <header class="site-header">
      <div class="brand">
        <a href={`${base}${locale}/`}>Moderno</a>
      </div>
      <nav class="site-nav" aria-label={t("nav.docs")}>
        <a href={`${base}${locale}/`}>{t("nav.components")}</a>
        <a href={`${base}${locale}/theme-builder`}>{t("nav.themeBuilder")}</a>
      </nav>
      <div class="header-tools">
        <Search locale={locale} />
        <LanguageSwitcher locale={locale} slug={slug} />
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <div class:list={["layout", tocHeadings.length > 0 && "layout--with-toc"]}>
      <aside class="sidebar" aria-label={t("nav.docs")}>
        {
          sections.map((section) => (
            <section class="sidebar-group">
              <h2>{section.group}</h2>
              <ul>
                {section.pages.map((p) => (
                  <li>
                    <a
                      href={`${base}${locale}/${p.slug}`}
                      aria-current={p.slug === slug ? "page" : undefined}
                    >
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </aside>

      <main id="main" data-pagefind-body>
        <slot />
      </main>
      {tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} locale={locale} />}
    </div>

    <script src="../scripts/clipboard.ts"></script>
  </body>
</html>
