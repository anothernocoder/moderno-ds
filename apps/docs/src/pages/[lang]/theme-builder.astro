---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThemeBuilder from "../../islands/ThemeBuilder.svelte";
import { locales, useTranslations, type Locale } from "../../i18n/ui.ts";
import { registryThemes } from "../../lib/siteThemes.ts";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const strings = {
  light: t("theme.light"),
  dark: t("theme.dark"),
  name: t("theme.name"),
  description: t("theme.description"),
  descriptionHint: t("theme.descriptionHint"),
  notesKept: t("theme.notesKept"),
  notesDraft: t("theme.notesDraft"),
  notesLoading: t("theme.notesLoading"),
  startFrom: t("theme.startFrom"),
  import: t("theme.import"),
  paste: t("theme.paste"),
  reset: t("theme.reset"),
  export: t("theme.export"),
  copy: t("theme.copy"),
  download: t("theme.download"),
  pickColor: t("theme.pickColor"),
  cliSnippet: t("theme.cliSnippet"),
  contrastOk: t("theme.contrastOk"),
  contrastFail: t("theme.contrastFail"),
  invalid: t("theme.invalid"),
  copied: t("copy.copied"),
  inherited: t("theme.inherited"),
  customize: t("theme.customize"),
  closePanel: t("theme.closePanel"),
  contrast: t("theme.contrast"),
  preview: t("theme.preview"),
  groups: {
    surfaces: t("theme.group.surfaces"),
    brand: t("theme.group.brand"),
    support: t("theme.group.support"),
    charts: t("theme.group.charts"),
    other: t("theme.group.other"),
    extended: t("theme.group.extended"),
  },
};
---

<BaseLayout locale={lang} title={t("theme.title")} description={t("theme.lead")} slug="theme-builder" wide>
  <h1>{t("theme.title")}</h1>
  <p class="page-lead">{t("theme.lead")}</p>
  <ThemeBuilder strings={strings} bases={registryThemes} client:only="svelte" />
</BaseLayout>
