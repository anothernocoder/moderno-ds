---
import { defaultLocale } from "../i18n/ui.ts";
// BASE_URL has no trailing slash ("" on Vercel, "/moderno-ds" on GitHub
// Pages), so strip any that's there and add our own separator explicitly.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Moderno</title>
  </head>
  <body>
    <a href={target}>Moderno</a>
  </body>
</html>
