---
import { currentLocale, useTranslations } from "../i18n/ui.ts";

/** Shape of a generated `props/<name>.json` (mirrors @moderno-ui/props-doc). */
interface PropDoc {
  name: string;
  type: string;
  required: boolean;
  default?: string;
  description?: string;
}
interface ComponentDoc {
  name: string;
  props: PropDoc[];
}

interface Props {
  /** Component name matching a generated `props/<name>.json`. */
  component: string;
}

const { component } = Astro.props;
const t = useTranslations(currentLocale(Astro.currentLocale));

// Generated at build by `moderno-props-doc` (the prebuild step). Loaded eagerly
// so a missing component surfaces as a clear build-time error, not a 404.
const modules = import.meta.glob<ComponentDoc>("../generated/props/*.json", { eager: true });
const entry = Object.entries(modules).find(([path]) => path.endsWith(`/${component}.json`));
const doc = entry?.[1] as ComponentDoc | undefined;
const props = doc?.props ?? [];
const hasDescriptions = props.some((p) => p.description);
---

{
  props.length === 0 ? (
    <p class="props-empty">{t("props.empty")}</p>
  ) : (
    <div class="props-table-wrap">
      <table class="props-table">
        <thead>
          <tr>
            <th scope="col">{t("props.name")}</th>
            <th scope="col">{t("props.type")}</th>
            <th scope="col">{t("props.default")}</th>
            {hasDescriptions && <th scope="col">{t("props.description")}</th>}
          </tr>
        </thead>
        <tbody>
          {props.map((p) => (
            <tr>
              <th scope="row" class="props-name">
                <code>{p.name}</code>
                {p.required && (
                  <span class="props-required" title={t("props.requiredLabel")}>
                    {t("props.required")}
                  </span>
                )}
              </th>
              <td>
                <code class="props-type">{p.type}</code>
              </td>
              <td>{p.default ? <code class="props-default">{p.default}</code> : <span class="props-none">—</span>}</td>
              {hasDescriptions && <td class="props-description">{p.description ?? ""}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
