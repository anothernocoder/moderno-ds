---
import type { CodeLanguage } from "astro";
import { Code } from "astro:components";
import shikiConfig from "../../shiki.config.ts";

interface Props {
  code: string;
  lang?: CodeLanguage;
}

const { code, lang = "tsx" } = Astro.props;
---

<div class="code-block">
  <Code code={code} lang={lang} {...shikiConfig} />
</div>
