---
import { Check, Copy, FileText } from "@lucide/astro";
import { currentLocale, useTranslations } from "../i18n/ui.ts";

// Derive locale + slug from the route so MDX can drop `<CopyMarkdown />` bare.
const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
// Astro.url.pathname includes the configured base ("/moderno-ds/en/button"
// on GitHub Pages), so strip it before splitting off the locale segment.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = base && Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const path = pathname.replace(/^\/+|\/+$/g, "").split("/");
const slug = path.slice(1).join("/") || "index";
// Fetches the page's generated `.md` twin and copies it — same source the
// per-component `.md` files and `llms.txt` are built from.
const mdUrl = `${base}/${locale}/${slug}.md`;
---

<div class="page-actions" data-pagefind-ignore>
  <button type="button" class="page-action" data-copy-url={mdUrl} data-copied={t("copy.copied")}>
    <Copy class="page-action-idle" aria-hidden="true" size={13} />
    <Check class="page-action-done" aria-hidden="true" size={13} />
    <span>{t("copy.markdown")}</span>
  </button>
  <a class="page-action" href={mdUrl}>
    <FileText aria-hidden="true" size={13} />
    <span>{t("copy.viewMarkdown")}</span>
  </a>
</div>
