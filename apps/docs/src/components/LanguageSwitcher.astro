---
import { Languages } from "@lucide/astro";
import { locales, useTranslations, type Locale } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);
const other = locales.find((l) => l !== locale)!;
const path = slug === "index" ? "" : slug;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a
  class="lang-switch"
  href={`${base}/${other}/${path}`}
  hreflang={other}
  lang={other}
  aria-label={t("lang.switch")}
  title={t("lang.switch")}
>
  <Languages aria-hidden="true" size={15} />
  <span class="lang-switch-long">{t("lang.switch")}</span>
  <span class="lang-switch-short" aria-hidden="true">{t("lang.short")}</span>
</a>
