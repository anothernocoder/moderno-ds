---
/**
 * ⌘K / Ctrl+K search dialog. Queries the locale's Pagefind bundle directly
 * through `pagefind.search()` / `pagefind.debouncedSearch()` — Pagefind's
 * stock `PagefindUI` (its JS and CSS) is never loaded, so the dialog is
 * styled entirely from the contract tokens and re-themes with the site.
 * Results are grouped by page, with each page's `sub_results` (its matching
 * sections) listed underneath.
 */
import { Search as SearchIcon } from "@lucide/astro";
import { useTranslations, type Locale } from "../i18n/ui.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// Each locale is indexed into its own bundle (dist/<locale>/pagefind) by the
// postbuild `pnpm index` step, so search never mixes languages.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const bundlePath = `${base}/${locale}/pagefind/`;
---

<div data-pagefind-ignore>
  <button type="button" class="search-trigger" data-search-trigger aria-haspopup="dialog">
    <SearchIcon aria-hidden="true" size={16} />
    <span>{t("search.trigger")}</span>
  </button>

  <dialog class="search-dialog" data-search-dialog data-bundle={bundlePath} aria-label={t("search.label")}>
    <div class="search-dialog-inner">
      <div class="search-input-row">
        <SearchIcon aria-hidden="true" size={16} />
        <input
          type="search"
          class="search-input"
          data-search-input
          placeholder={t("search.placeholder")}
          aria-label={t("search.label")}
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div class="search-results" data-search-results role="listbox" aria-label={t("search.label")} hidden></div>
      <p class="search-state" data-search-empty>{t("search.empty")}</p>
      <p class="search-state" data-search-no-results hidden>{t("search.noResults")}</p>
      <p class="search-state" data-search-missing hidden>{t("search.indexMissing")}</p>
    </div>
  </dialog>
</div>

<script src="../scripts/search.ts"></script>
