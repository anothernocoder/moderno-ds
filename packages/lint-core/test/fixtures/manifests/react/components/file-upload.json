    { "name": "dropzone" },
    { "name": "dropzone-icon" },
    { "name": "dropzone-title" },
    { "name": "dropzone-hint" },
    { "name": "item-group" },
    { "name": "item" },
    { "name": "item-preview" },
    { "name": "item-preview-image" },
    { "name": "item-name" },
    { "name": "item-name-full" },
    { "name": "item-name-start" },
    { "name": "item-name-end" },
    { "name": "item-size-text" },
    { "name": "item-error" },
    { "name": "item-delete-trigger" }
  ],
  "variants": { "size": ["sm", "md", "lg"] },
