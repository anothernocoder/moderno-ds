  "import": "import { FileUpload } from \"@moderno-ui/react\"",
  "propsHash": "sha256:fixture-file-upload",
  "props": [
    { "name": "accept", "type": "FileUploadAccept", "required": false },
    { "name": "disabled", "type": "boolean", "required": false },
    { "name": "label", "type": "string", "required": false },
    { "name": "maxFileSize", "type": "number", "required": false },
    { "name": "maxFiles", "type": "number", "required": false },
    {
      "name": "onFileChange",
      "type": "((details: FileUploadFileChangeDetails) => void)",
      "required": false
