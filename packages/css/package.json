{
  "name": "@moderno-ui/css",
  "version": "0.3.0",
  "description": "Moderno's CSS package: the shadcn-style semantic token contract with neutral OKLCH defaults, the shared component stylesheet, a Tailwind v4 preset, the contract as data and the agent manifest. Contains no brand identity.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anothernocoder/moderno-ds.git",
    "directory": "packages/css"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./preset": "./src/preset.css",
    "./contract": "./src/contract.ts",
    "./moderno.agent.json": "./dist/moderno.agent.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --experimental-strip-types ../../tooling/props-doc/src/bin-agent-manifest.ts css"
  },
  "dependencies": {
    "@moderno-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
