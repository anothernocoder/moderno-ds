{
  "name": "@moderno-ui/css",
  "version": "0.3.0",
  "description": "Single public CSS entrypoint for Moderno. Re-exports the token contract; hides internal package paths.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anothernocoder/moderno-ds.git",
    "directory": "packages/css"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.css",
    "./preset": "./src/preset.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@moderno-ui/core": "workspace:*",
    "@moderno-ui/tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
