{
  "name": "@moderno-ui/vue",
  "version": "0.3.0",
  "description": "Vue 3 bindings for Moderno: Ark UI headless behaviour + @moderno-ui/core CVA (props → data-attributes), styled entirely by the shared components.css.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anothernocoder/moderno-ds.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./moderno.agent.json": "./dist/moderno.agent.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node --experimental-strip-types ../../tooling/props-doc/src/bin-agent-manifest.ts vue",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.37.2",
    "@moderno-ui/charts-core": "workspace:*",
    "@moderno-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "@moderno-ui/css": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@moderno-ui/props-doc": "workspace:*",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/server-renderer": "^3.5.38",
    "tsup": "^8.3.5",
    "vue": "^3.5.38",
    "vue-tsc": "^2.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
