{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "playground/**/*.tsx",
    "tsup.config.ts",
    "../../apps/docs/src/examples/**/react.tsx",
    "../../apps/docs/src/examples/field/invalid-snippet.tsx"
  ]
}
