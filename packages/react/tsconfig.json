{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    // The Generative UI docs example imports a Block as an app does; it and
    // the registry source it resolves to (no node_modules) use these copies.
    "paths": {
      "@/components/blocks/stat-row": ["../../registry/blocks/stat-row/react/stat-row.tsx"],
      "@moderno-ui/react": ["./src/index.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "playground/**/*.tsx",
    "tsup.config.ts",
    "../../apps/docs/src/examples/**/react.tsx"
  ]
}
