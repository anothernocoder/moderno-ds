{
  "name": "@moderno-ui/genui",
  "version": "0.0.0",
  "description": "Generative UI for Moderno: a System One model routes each message, an LLM writes OpenUI Lang against a component library derived from moderno.agent.json, and OpenUI's Renderer draws it with @moderno-ui/react.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anothernocoder/moderno-ds.git",
    "directory": "packages/genui"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@openuidev/lang-core": "~0.3.1",
    "@openuidev/react-lang": "~0.3.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@moderno-ui/react": "workspace:>=0.5.0 <1.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@moderno-ui/react": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
