{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The playground imports Blocks from registry/, which has no node_modules:
    // their imports resolve to this package's copies, as in the dev server.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@moderno-ui/react": ["./node_modules/@moderno-ui/react/dist/index.d.ts"]
    }
  },
  "include": ["src", "test", "playground", "tsup.config.ts", "playwright.config.ts"]
}
